        let state = {
            currentArticle: ARTICLES[0],
            lineDuration: 5.0,     // 預設每行字顯示 5 秒
            spawnInterval: 2.5,    // 預設每隔 2.5 秒產生新的一行
            activeLines: [],       // 正在軌道上顯示的文字物件
            currentLineIndex: 0,   // 目前準備產生的文字行索引
            isPaused: false,
            timerId: null,         // 產生文字行的主定時器
            elapsedTime: 0,        // 閱讀花費總秒數
            elapsedTimerId: null,  // 統計總時長的定時器
            quizCurrentIndex: 0,   // 當前回答到第幾題
            userAnswers: [],       // 儲存使用者的答案
            readingStartTime: 0
        };

        /* ----------------------------------------------------
           3. 網頁初始化載入
           ---------------------------------------------------- */
        window.onload = function() {
            // 初始化深淺色主題
            if (localStorage.getItem('theme') === 'light') {
                document.documentElement.classList.remove('dark');
                document.getElementById('theme-icon').className = 'fa-solid fa-sun';
            } else {
                document.documentElement.classList.add('dark');
                document.getElementById('theme-icon').className = 'fa-solid fa-moon';
            }

            renderArticles();
            updateSliders();
            loadHistory();
        };

        // 切換主題色
        function toggleTheme() {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
            document.getElementById('theme-icon').className = isDark ? 'fa-solid fa-moon' : 'fa-solid fa-sun';
        }

        /* ----------------------------------------------------
           4. STREAMING_CHUNK: 大廳與參數控制模組
           ---------------------------------------------------- */
        // 渲染文章卡片
        function renderArticles() {
            const container = document.getElementById('article-list');
            container.innerHTML = '';

            ARTICLES.forEach(art => {
                const isSelected = state.currentArticle.id === art.id;
                const totalChars = art.lines.reduce((sum, line) => sum + line.length, 0);
                
                const card = document.createElement('div');
                card.id = `card-${art.id}`;
                card.className = `cursor-pointer p-5 rounded-2xl border-2 transition-all relative overflow-hidden group bg-white dark:bg-slate-900 ${
                    isSelected 
                    ? 'border-brand-500 ring-2 ring-brand-500/20' 
                    : 'border-slate-200 dark:border-slate-800 hover:border-brand-500'
                }`;
                card.onclick = () => selectArticle(art.id);

                card.innerHTML = `
                    <div class="absolute right-2 bottom-2 text-slate-100 dark:text-slate-800/40 text-6xl font-black group-hover:scale-110 transition-transform pointer-events-none">
                        <i class="fa-solid ${art.icon}"></i>
                    </div>
                    <div class="relative z-10 space-y-3">
                        <span class="px-2.5 py-1 text-[10px] font-bold uppercase rounded-md bg-gradient-to-r ${art.color} text-white shadow-sm">
                            ${art.category}
                        </span>
                        <div class="space-y-1">
                            <h4 class="font-extrabold text-slate-800 dark:text-slate-100 group-hover:text-brand-500 transition-colors">
                                ${art.title}
                            </h4>
                            <div class="flex items-center space-x-3 text-xs text-slate-500">
                                <span><i class="fa-solid fa-align-left mr-1"></i>${totalChars} 字</span>
                                <span>•</span>
                                <span><i class="fa-solid fa-signal mr-1"></i>${art.difficulty}</span>
                            </div>
                        </div>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        // 選擇文章
        function selectArticle(id) {
            const article = ARTICLES.find(a => a.id === id);
            if (article) {
                state.currentArticle = article;
                renderArticles();
            }
        }

        // 滑桿與預設值同步
        function updateSliders() {
            state.lineDuration = parseFloat(document.getElementById('slider-duration').value);
            state.spawnInterval = parseFloat(document.getElementById('slider-interval').value);
            
            document.getElementById('display-duration').innerText = `${state.lineDuration.toFixed(1)} 秒`;
            document.getElementById('display-interval').innerText = `${state.spawnInterval.toFixed(1)} 秒`;
            
            // 取消所有難度預設按鈕的高亮
            document.querySelectorAll('.preset-btn').forEach(btn => {
                btn.className = "preset-btn px-3 py-2 rounded-xl text-sm border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-300 transition-all font-medium hover:border-brand-500";
            });
        }

        // 難度預設快速按鈕
        function setPreset(level) {
            const sliderDuration = document.getElementById('slider-duration');
            const sliderInterval = document.getElementById('slider-interval');

            if (level === 'beginner') {
                sliderDuration.value = 6.0;
                sliderInterval.value = 3.5;
            } else if (level === 'intermediate') {
                sliderDuration.value = 5.0;
                sliderInterval.value = 2.5;
            } else if (level === 'advanced') {
                sliderDuration.value = 4.0;
                sliderInterval.value = 2.0;
            } else if (level === 'expert') {
                sliderDuration.value = 3.0;
                sliderInterval.value = 1.5;
            }
            
            updateSliders();

            // 為被點選的按鈕套用高亮
            const activeBtn = document.getElementById(`preset-${level}`);
            if (activeBtn) {
                activeBtn.className = "preset-btn px-3 py-2 rounded-xl text-sm border border-brand-500 bg-brand-50 dark:bg-brand-950/40 text-brand-600 dark:text-brand-400 font-semibold transition-all";
            }
        }

        /* ----------------------------------------------------
           5. STREAMING_CHUNK: 倒數與速讀引擎核心邏輯
           ---------------------------------------------------- */
        // 開始倒數計時 3, 2, 1
        function startCountdown() {
            document.getElementById('lobby-view').classList.add('hidden');
            document.getElementById('countdown-view').classList.remove('hidden');

            let count = 3;
            const numEl = document.getElementById('countdown-number');
            numEl.innerText = count;
            
            const countInterval = setInterval(() => {
                count--;
                if (count > 0) {
                    numEl.innerText = count;
                    numEl.classList.remove('scale-100');
                    numEl.classList.add('scale-125');
                    setTimeout(() => numEl.classList.remove('scale-125'), 100);
                } else {
                    clearInterval(countInterval);
                    document.getElementById('countdown-view').classList.add('hidden');
                    initiateReadingChallenge();
                }
            }, 1000);
        }

        // 啟動速讀主邏輯
        function initiateReadingChallenge() {
            document.getElementById('reading-view').classList.remove('hidden');
            
            // 初始化狀態
            state.activeLines = [];
            state.currentLineIndex = 0;
            state.isPaused = false;
            state.elapsedTime = 0;
            state.userAnswers = [];
            
            document.getElementById('text-container').innerHTML = '';
            document.getElementById('pause-overlay').classList.add('hidden');
            document.getElementById('reading-article-title').innerText = state.currentArticle.title;
            
            updateReadingProgressBadge();

            // 啟動閱讀計時器 (計算實際耗時)
            state.readingStartTime = Date.now();
            state.elapsedTimerId = setInterval(() => {
                if (!state.isPaused) {
                    state.elapsedTime += 0.1;
                }
            }, 100);

            // 產生第一行文字
            spawnNextLine();

            // 設定行生成定時器
            scheduleNextSpawn();
        }

        // 動態排程下一次文字出現
        function scheduleNextSpawn() {
            if (state.timerId) clearTimeout(state.timerId);
            
            state.timerId = setTimeout(() => {
                if (!state.isPaused) {
                    spawnNextLine();
                }
            }, state.spawnInterval * 1000);
        }

        // 生成下一行字並在5秒後移除
        function spawnNextLine() {
            const lines = state.currentArticle.lines;
            
            if (state.currentLineIndex >= lines.length) {
                // 文章所有行皆已生成，等待場上最後一行消失後進入測驗
                checkReadingFinished();
                return;
            }

            const currentText = lines[state.currentLineIndex];
            const lineId = 'line-' + Date.now() + '-' + state.currentLineIndex;
            state.currentLineIndex++;
            
            updateReadingProgressBadge();

            // 1. 創建行包裝容器 DOM
            const lineDiv = document.createElement('div');
            lineDiv.id = lineId;
            // 初始透明且下移，用作滑入效果
            lineDiv.className = "opacity-0 translate-y-4 transition-all duration-500 ease-out flex flex-col items-center justify-center space-y-1.5 py-2";
            
            // 2. 內部文字與能量指示條
            lineDiv.innerHTML = `
                <p class="text-xl md:text-2xl font-bold tracking-wide text-slate-800 dark:text-slate-100 drop-shadow-sm select-none text-center px-4 leading-relaxed">
                    ${currentText}
                </p>
                <div class="w-32 bg-slate-100 dark:bg-slate-800/80 h-[4px] rounded-full overflow-hidden">
                    <div id="bar-${lineId}" class="bg-gradient-to-r from-brand-500 to-indigo-500 h-full w-full transition-all linear"></div>
                </div>
            `;

            // 3. 加入容器中
            const track = document.getElementById('text-container');
            track.appendChild(lineDiv);

            // 4. 強制瀏覽器 Reflow 以觸發滑入淡入動畫
            setTimeout(() => {
                lineDiv.classList.remove('opacity-0', 'translate-y-4');
                lineDiv.classList.add('opacity-100', 'translate-y-0');
            }, 50);

            // 5. 控制底部的倒數能量條
            const shrinkBar = document.getElementById(`bar-${lineId}`);
            // 設定 CSS transition 時間使能量條緩緩縮為 0
            shrinkBar.style.transitionDuration = `${state.lineDuration}s`;
            setTimeout(() => {
                shrinkBar.style.width = '0%';
            }, 100);

            // 6. 設定消失定時器 (生命週期結束)
            const vanishTimer = setTimeout(() => {
                // 開始淡出向上飛走
                lineDiv.classList.add('line-fade-out');
                
                // 完全淡出後徹底從 DOM 中移除並從追蹤名單中洗掉
                setTimeout(() => {
                    lineDiv.remove();
                    state.activeLines = state.activeLines.filter(item => item.id !== lineId);
                    
                    // 如果文章發送完畢且場上也沒有殘留文字，即刻跳轉
                    if (state.currentLineIndex >= lines.length && state.activeLines.length === 0) {
                        finishReadingAndStartQuiz();
                    }
                }, 500);

            }, state.lineDuration * 1000);

            // 紀錄該行狀態
            state.activeLines.push({
                id: lineId,
                vanishTimer: vanishTimer,
                spawnedTime: Date.now(),
                divRef: lineDiv
            });

            // 繼續排程下一行
            scheduleNextSpawn();
        }

        // 更新頂部小進度條
        function updateReadingProgressBadge() {
            const total = state.currentArticle.lines.length;
            const current = state.currentLineIndex;
            document.getElementById('reading-progress-badge').innerText = `行數 ${current} / ${total}`;
            
            const percent = (current / total) * 100;
            document.getElementById('reading-progress-bar').style.width = `${percent}%`;
        }

        // 檢查是否閱讀結束 (場上所有行都消失)
        function checkReadingFinished() {
            if (state.activeLines.length === 0) {
                finishReadingAndStartQuiz();
            }
        }

        /* ----------------------------------------------------
           6. STREAMING_CHUNK: 暫停與放棄模組
           ---------------------------------------------------- */
        // 暫停/繼續挑戰
        function togglePause() {
            if (state.isPaused) {
                // 恢復挑戰
                state.isPaused = false;
                document.getElementById('pause-overlay').classList.add('hidden');
                document.getElementById('pause-icon').className = 'fa-solid fa-pause mr-1';
                document.getElementById('btn-pause').innerText = '暫停';
                document.getElementById('btn-pause').className = "px-3 py-1.5 rounded-lg text-xs font-bold bg-amber-100 text-amber-700 hover:bg-amber-200 dark:bg-amber-950/40 dark:text-amber-300 dark:hover:bg-amber-900/50 transition-all";
                
                // 清理舊的，直接從目前行號重新啟動排程
                if (state.timerId) clearTimeout(state.timerId);
                scheduleNextSpawn();
            } else {
                // 暫停挑戰
                state.isPaused = true;
                document.getElementById('pause-overlay').classList.remove('hidden');
                document.getElementById('pause-icon').className = 'fa-solid fa-play mr-1';
                document.getElementById('btn-pause').innerText = '繼續';
                document.getElementById('btn-pause').className = "px-3 py-1.5 rounded-lg text-xs font-bold bg-emerald-100 text-emerald-700 hover:bg-emerald-200 dark:bg-emerald-950/40 dark:text-emerald-300 dark:hover:bg-emerald-900/50 transition-all";
                
                // 暫停時清除所有的生存定時器，場上文字全數清空，避免作弊或亂套
                if (state.timerId) clearTimeout(state.timerId);
                state.activeLines.forEach(line => {
                    clearTimeout(line.vanishTimer);
                    line.divRef.remove();
                });
                state.activeLines = [];
                
                // 如果暫停了，為求公平，恢復時當前行往前退一行以便重新讀取
                if (state.currentLineIndex > 0) {
                    state.currentLineIndex--;
                }
            }
        }

        // 放棄挑戰
        function quitChallenge() {
            if (confirm("確定要放棄這次閱讀訓練嗎？")) {
                cleanupTimers();
                document.getElementById('reading-view').classList.add('hidden');
                document.getElementById('lobby-view').classList.remove('hidden');
            }
        }

        // 清除所有運作中的計時器
        function cleanupTimers() {
            if (state.timerId) clearTimeout(state.timerId);
            if (state.elapsedTimerId) clearInterval(state.elapsedTimerId);
            state.activeLines.forEach(line => clearTimeout(line.vanishTimer));
            state.activeLines = [];
        }

        /* ----------------------------------------------------
           7. STREAMING_CHUNK: 測驗作答模組
           ---------------------------------------------------- */
        // 文章播放完畢，跳轉到測驗
        function finishReadingAndStartQuiz() {
            cleanupTimers();
            document.getElementById('reading-view').classList.add('hidden');
            document.getElementById('quiz-view').classList.remove('hidden');
            
            state.quizCurrentIndex = 0;
            state.userAnswers = [];
            
            showQuizQuestion();
        }

        // 渲染測驗題目
        function showQuizQuestion() {
            const art = state.currentArticle;
            const qIndex = state.quizCurrentIndex;
            const qData = art.questions[qIndex];
            
            document.getElementById('quiz-stepper').innerText = `第 ${qIndex + 1} / ${art.questions.length} 題`;
            document.getElementById('quiz-question-text').innerText = qData.q;
            
            const optionsBox = document.getElementById('quiz-options-container');
            optionsBox.innerHTML = '';

            const alphabet = ['A', 'B', 'C', 'D'];
            
            qData.options.forEach((opt, idx) => {
                const btn = document.createElement('button');
                btn.className = "w-full text-left p-4 rounded-xl border border-slate-200 dark:border-slate-800 hover:border-brand-500 bg-slate-50 dark:bg-slate-900/50 hover:bg-brand-50/50 dark:hover:bg-brand-950/20 flex items-center space-x-4 transition-all group";
                btn.onclick = () => selectQuizAnswer(idx);
                
                btn.innerHTML = `
                    <span class="w-8 h-8 rounded-lg bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-extrabold flex items-center justify-center group-hover:bg-brand-500 group-hover:text-white transition-all text-sm">
                        ${alphabet[idx]}
                    </span>
                    <span class="font-semibold text-slate-700 dark:text-slate-200 text-sm md:text-base">${opt}</span>
                `;
                optionsBox.appendChild(btn);
            });
        }

        // 作答處理
        function selectQuizAnswer(selectedIndex) {
            state.userAnswers.push(selectedIndex);
            
            state.quizCurrentIndex++;
            if (state.quizCurrentIndex < state.currentArticle.questions.length) {
                // 還有題目，進入下一題
                showQuizQuestion();
            } else {
                // 答題完成，計算結果
                compileResults();
            }
        }

        /* ----------------------------------------------------
           8. STREAMING_CHUNK: 成果計算與數據分析
           ---------------------------------------------------- */
        function compileResults() {
            document.getElementById('quiz-view').classList.add('hidden');
            document.getElementById('results-view').classList.remove('hidden');

            const art = state.currentArticle;
            const totalQuestions = art.questions.length;
            let correctCount = 0;

            art.questions.forEach((q, idx) => {
                if (state.userAnswers[idx] === q.ans) {
                    correctCount++;
                }
            });

            const scorePercent = Math.round((correctCount / totalQuestions) * 100);

            // 計算字數
            const totalChars = art.lines.reduce((sum, line) => sum + line.length, 0);
            
            // 計算 CPM = (總字數 / 閱讀時間) * 60
            const readingDurationMin = state.elapsedTime / 60;
            const cpm = Math.round(totalChars / readingDurationMin);

            // 1. 動態繪製圓形環狀進度條
            const scoreRing = document.getElementById('result-score-ring');
            scoreRing.style.strokeDasharray = `${scorePercent}, 100`;
            document.getElementById('result-score-text').innerText = `${scorePercent}%`;

            // 2. 理解度等級評價
            let evaluation = "";
            let evalColor = "text-brand-500";
            if (scorePercent === 100) {
                evaluation = "👑 完美理解！過目不忘";
                evalColor = "text-emerald-500";
                // 撒花慶祝！
                triggerConfetti();
            } else if (scorePercent >= 80) {
                evaluation = "🌟 優秀！掌握了核心細節";
                evalColor = "text-teal-500";
            } else if (scorePercent >= 60) {
                evaluation = "👍 及格！閱讀節奏感不錯";
                evalColor = "text-amber-500";
            } else {
                evaluation = "💔 需再加油！只求快而忽略了吸收";
                evalColor = "text-rose-500";
            }
            const evalEl = document.getElementById('result-evaluation');
            evalEl.innerText = evaluation;
            evalEl.className = `text-sm font-bold ${evalColor} mt-2`;

            // 3. 字速表現文字分析
            document.getElementById('result-cpm-text').innerHTML = `${cpm} <span class="text-sm font-medium text-slate-400">字/分</span>`;
            let cpmDesc = "";
            if (cpm >= 1000) {
                cpmDesc = "🚀 驚人的大師級視讀！你的大腦如同相機快門，直接成塊吸收資訊。";
            } else if (cpm >= 600) {
                cpmDesc = "⚡ 極速狂飆！已經超越八成以上常人的閱讀極限速度。";
            } else if (cpm >= 400) {
                cpmDesc = "📈 優秀速讀！正在有效擺脫心中默讀，視覺處理效率大幅提昇。";
            } else {
                cpmDesc = "🌱 初階起步！可以嘗試縮減每行字消失秒數，強迫眼球擴大視幅。";
            }
            document.getElementById('result-cpm-desc').innerText = cpmDesc;

            // 4. 其他基礎數據填寫
            document.getElementById('result-article-name').innerText = art.title;
            document.getElementById('result-total-chars').innerText = `${totalChars} 字`;
            document.getElementById('result-seconds-setting').innerText = `${state.lineDuration.toFixed(1)} 秒`;
            document.getElementById('result-time-taken').innerText = `${state.elapsedTime.toFixed(1)} 秒`;

            // 5. 生成題回復盤解析 DOM
            const reviewBox = document.getElementById('results-review-container');
            reviewBox.innerHTML = '';
            
            const alphabet = ['A', 'B', 'C', 'D'];
            art.questions.forEach((q, idx) => {
                const userChoice = state.userAnswers[idx];
                const isCorrect = userChoice === q.ans;
                
                const qDiv = document.createElement('div');
                qDiv.className = "pt-4 space-y-2";
                qDiv.innerHTML = `
                    <div class="flex items-start justify-between">
                        <div class="space-y-1">
                            <span class="text-xs font-bold text-slate-400">第 ${idx + 1} 題</span>
                            <h4 class="font-bold text-slate-800 dark:text-slate-100">${q.q}</h4>
                        </div>
                        <span class="px-2.5 py-0.5 rounded-full text-xs font-bold flex items-center space-x-1 ${
                            isCorrect 
                            ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-300' 
                            : 'bg-rose-100 text-rose-800 dark:bg-rose-950/40 dark:text-rose-300'
                        }">
                            <i class="fa-solid ${isCorrect ? 'fa-circle-check' : 'fa-circle-xmark'} mr-1"></i>
                            <span>${isCorrect ? '答對' : '答錯'}</span>
                        </span>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-2 text-xs text-slate-600 dark:text-slate-400">
                        <p>你的答案：<span class="font-bold ${isCorrect ? 'text-emerald-500' : 'text-rose-500'}">(${alphabet[userChoice]}) ${q.options[userChoice]}</span></p>
                        <p>正確答案：<span class="font-bold text-emerald-500">(${alphabet[q.ans]}) ${q.options[q.ans]}</span></p>
                    </div>
                    <div class="bg-slate-50 dark:bg-slate-950 p-3 rounded-lg text-xs leading-relaxed border-l-2 border-brand-500 text-slate-500">
                        <strong>解析：</strong>${q.explain}
                    </div>
                `;
                reviewBox.appendChild(qDiv);
            });

            // 6. 保存歷史數據
            saveHistory(art.title, scorePercent, cpm, state.lineDuration);
        }

        // 灑花祝賀
        function triggerConfetti() {
            confetti({
                particleCount: 120,
                spread: 70,
                origin: { y: 0.6 },
                colors: ['#8b5cf6', '#3b82f6', '#10b981', '#ec4899']
            });
        }

        /* ----------------------------------------------------
           9. STREAMING_CHUNK: 歷史紀錄存儲模組 (LocalStorage)
           ---------------------------------------------------- */
        function saveHistory(articleTitle, score, cpm, seconds) {
            const records = JSON.parse(localStorage.getItem('speed_reading_history') || '[]');
            const newRecord = {
                id: Date.now(),
                title: articleTitle,
                score: score,
                cpm: cpm,
                seconds: seconds,
                date: new Date().toLocaleDateString('zh-TW', { hour: '2-digit', minute: '2-digit' })
            };
            records.unshift(newRecord); // 最新紀錄排在最前
            localStorage.setItem('speed_reading_history', JSON.stringify(records));
            loadHistory();
        }

        function loadHistory() {
            const records = JSON.parse(localStorage.getItem('speed_reading_history') || '[]');
            const container = document.getElementById('history-list-container');
            
            if (records.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-8 space-y-2">
                        <i class="fa-solid fa-folder-open text-slate-300 dark:text-slate-700 text-4xl"></i>
                        <p class="text-sm text-slate-500">目前還沒有任何挑戰紀錄喔，快開始第一場吧！</p>
                    </div>
                `;
                return;
            }

            container.innerHTML = '';
            records.forEach(r => {
                const item = document.createElement('div');
                item.className = "p-4 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 flex items-center justify-between space-x-4";
                item.innerHTML = `
                    <div class="space-y-1 truncate flex-grow">
                        <h4 class="font-bold text-sm text-slate-800 dark:text-slate-200 truncate">${r.title}</h4>
                        <div class="flex items-center space-x-3 text-[11px] text-slate-500">
                            <span><i class="fa-solid fa-clock mr-1"></i>${r.date}</span>
                            <span>•</span>
                            <span><i class="fa-solid fa-bolt mr-1"></i>${r.seconds}s 設定</span>
                        </div>
                    </div>
                    <div class="flex items-center space-x-3 shrink-0">
                        <div class="text-right">
                            <span class="block text-xs text-slate-400">理解度</span>
                            <span class="text-sm font-black ${r.score >= 60 ? 'text-teal-500' : 'text-rose-500'}">${r.score}%</span>
                        </div>
                        <div class="text-right">
                            <span class="block text-xs text-slate-400">速讀率</span>
                            <span class="text-sm font-black text-brand-500">${r.cpm} <span class="text-[10px] font-normal">字/分</span></span>
                        </div>
                    </div>
                `;
                container.appendChild(item);
            });
        }

        function clearAllHistory() {
            if (confirm("確定要清除所有的學習成長軌跡嗎？清除後將無法復原。")) {
                localStorage.removeItem('speed_reading_history');
                loadHistory();
            }
        }

        function toggleHistoryModal() {
            const modal = document.getElementById('history-modal');
            modal.classList.toggle('hidden');
        }

        /* ----------------------------------------------------
           10. 面板切換與重啟控制
           ---------------------------------------------------- */
        // 重試同一個挑戰
        function restartSameChallenge() {
            document.getElementById('results-view').classList.add('hidden');
            startCountdown();
        }

        // 回到大廳
        function goBackToLobby() {
            document.getElementById('results-view').classList.add('hidden');
            document.getElementById('lobby-view').classList.remove('hidden');
            renderArticles();
        }
    </script>
</body>
</html>
