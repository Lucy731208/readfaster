<!DOCTYPE html>
<html lang="zh-TW" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>閃電速讀訓練艙 - 逼迫大腦極限的閱讀訓練</title>
    <!-- 引入 Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f5f3ff',
                            100: '#ede9fe',
                            500: '#8b5cf6',
                            600: '#7c3aed',
                            700: '#6d28d9',
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'PingFang TC', 'Microsoft JhengHei', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome 圖標 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Confetti 灑花特效 -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <style>
        /* 自訂滾動條 */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 3px;
        }
        .dark ::-webkit-scrollbar-thumb {
            background: #475569;
        }
        
        /* 縮減淡出動畫 */
        .line-fade-out {
            animation: fadeOutUp 0.5s forwards ease-in-out;
        }
        @keyframes fadeOutUp {
            from {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
            to {
                opacity: 0;
                transform: translateY(-20px) scale(0.95);
            }
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 min-h-screen transition-colors duration-300 font-sans flex flex-col justify-between">

    <!-- 導覽列 -->
    <header class="border-b border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/80 backdrop-blur-md sticky top-0 z-50">
        <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="bg-brand-500 text-white p-2 rounded-xl shadow-lg shadow-brand-500/30 animate-pulse">
                    <i class="fa-solid fa-bolt text-xl"></i>
                </div>
                <div>
                    <h1 class="font-black text-xl tracking-wider bg-gradient-to-r from-brand-500 to-pink-500 bg-clip-text text-transparent">
                        閃電速讀訓練艙
                    </h1>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Lightning Speed Reading Trainer</p>
                </div>
            </div>
            
            <div class="flex items-center space-x-3">
                <button id="btn-history-toggle" onclick="toggleHistoryModal()" class="p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-600 dark:text-slate-300 transition-all" title="歷史紀錄">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                </button>
                <button id="theme-toggle" onclick="toggleTheme()" class="p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-600 dark:text-slate-300 transition-all" title="切換主題">
                    <i id="theme-icon" class="fa-solid fa-moon"></i>
                </button>
            </div>
        </div>
    </header>

    <main class="flex-grow max-w-4xl w-full mx-auto px-4 py-6 flex flex-col justify-center">
        
        <!-- 大廳/配置畫面 (Lobby Container) -->
        <div id="lobby-view" class="space-y-6">
            <div class="text-center space-y-2">
                <span class="px-3 py-1 text-xs font-semibold bg-brand-100 text-brand-600 dark:bg-brand-900/50 dark:text-brand-300 rounded-full">
                    大腦開發挑戰
                </span>
                <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight">挑戰你的視覺處理速度！</h2>
                <p class="text-slate-600 dark:text-slate-400 max-w-lg mx-auto text-sm md:text-base">
                    文章文字將由上至下依序出現，且<span class="text-brand-500 font-bold dark:text-brand-400">每行文字在出現 5 秒後將徹底消失</span>！緊盯螢幕，抓取精髓，文章結束後將有5題閱讀測驗！
                </p>
            </div>

            <!-- 自訂配置參數 -->
            <div class="bg-white dark:bg-slate-900 rounded-2xl p-6 shadow-sm border border-slate-200 dark:border-slate-800 space-y-4">
                <h3 class="font-bold text-lg flex items-center space-x-2">
                    <i class="fa-solid fa-sliders text-brand-500"></i>
                    <span>速讀難度與參數自訂</span>
                </h3>
                
                <!-- 難度預設推薦 -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
                    <button type="button" onclick="setPreset('beginner')" id="preset-beginner" class="preset-btn px-3 py-2 rounded-xl text-sm border border-slate-200 dark:border-slate-800 transition-all font-medium hover:border-brand-500">
                        🌱 初學體驗 (6s 消失)
                    </button>
                    <button type="button" onclick="setPreset('intermediate')" id="preset-intermediate" class="preset-btn px-3 py-2 rounded-xl text-sm border border-brand-500 bg-brand-50 dark:bg-brand-950/40 text-brand-600 dark:text-brand-400 transition-all font-semibold">
                        ⚡ 標準訓練 (5s 消失)
                    </button>
                    <button type="button" onclick="setPreset('advanced')" id="preset-advanced" class="preset-btn px-3 py-2 rounded-xl text-sm border border-slate-200 dark:border-slate-800 transition-all font-medium hover:border-brand-500">
                        🔥 高階磨練 (4s 消失)
                    </button>
                    <button type="button" onclick="setPreset('expert')" id="preset-expert" class="preset-btn px-3 py-2 rounded-xl text-sm border border-slate-200 dark:border-slate-800 transition-all font-medium hover:border-brand-500">
                        💀 極速狂飆 (3s 消失)
                    </button>
                </div>

                <!-- 滑桿控制 -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
                    <div class="space-y-2">
                        <div class="flex justify-between text-sm">
                            <label class="text-slate-600 dark:text-slate-400">文字存留時間 (秒)</label>
                            <span id="display-duration" class="font-bold text-brand-500">5.0 秒</span>
                        </div>
                        <input type="range" id="slider-duration" min="1.5" max="10" step="0.5" value="5.0" oninput="updateSliders()" class="w-full h-2 bg-slate-200 dark:bg-slate-700 rounded-lg appearance-none cursor-pointer accent-brand-500">
                    </div>
                    <div class="space-y-2">
                        <div class="flex justify-between text-sm">
                            <label class="text-slate-600 dark:text-slate-400">下一行出現間隔 (秒)</label>
                            <span id="display-interval" class="font-bold text-brand-500">2.5 秒</span>
                        </div>
                        <input type="range" id="slider-interval" min="1.0" max="6.0" step="0.5" value="2.5" oninput="updateSliders()" class="w-full h-2 bg-slate-200 dark:bg-slate-700 rounded-lg appearance-none cursor-pointer accent-brand-500">
                    </div>
                </div>
            </div>

            <!-- 選擇文章區 -->
            <div class="space-y-3">
                <h3 class="font-bold text-lg flex items-center space-x-2">
                    <i class="fa-solid fa-book-open text-brand-500"></i>
                    <span>選擇要挑戰的文章</span>
                </h3>
                <div id="article-list" class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <!-- 文章卡片由 JS 動態生成 -->
                </div>
            </div>

            <!-- 開始按鈕 -->
            <div class="text-center pt-4">
                <button onclick="startCountdown()" class="w-full md:w-auto px-10 py-4 bg-gradient-to-r from-brand-500 to-indigo-600 hover:from-brand-600 hover:to-indigo-700 text-white font-bold text-lg rounded-2xl shadow-xl shadow-brand-500/20 hover:shadow-brand-500/30 transform hover:-translate-y-0.5 transition-all duration-200">
                    <i class="fa-solid fa-circle-play mr-2"></i>開始速讀挑戰
                </button>
            </div>
        </div>

        <!-- 3-2-1 準備倒數畫面 -->
        <div id="countdown-view" class="hidden flex flex-col items-center justify-center space-y-6 py-20">
            <div id="countdown-number" class="text-8xl md:text-9xl font-black text-brand-500 animate-bounce">
                3
            </div>
            <p class="text-lg text-slate-500 dark:text-slate-400 tracking-widest font-bold">保持專注，眼睛盯著螢幕中央...</p>
        </div>

        <!-- 閱讀主面板 (Reading View) -->
        <div id="reading-view" class="hidden space-y-6">
            <!-- 頂部進度與控制區 -->
            <div class="flex items-center justify-between bg-white dark:bg-slate-900 px-4 py-3 rounded-xl shadow-sm border border-slate-200 dark:border-slate-800">
                <div class="flex items-center space-x-3">
                    <span id="reading-progress-badge" class="px-3 py-1 text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 rounded-full">
                        正在載入...
                    </span>
                    <h3 id="reading-article-title" class="font-bold text-sm md:text-base text-slate-800 dark:text-slate-200 truncate max-w-[150px] md:max-w-xs">
                        文章標題
                    </h3>
                </div>
                <div class="flex items-center space-x-2">
                    <!-- 暫停鍵 -->
                    <button onclick="togglePause()" id="btn-pause" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-amber-100 text-amber-700 hover:bg-amber-200 dark:bg-amber-950/40 dark:text-amber-300 dark:hover:bg-amber-900/50 transition-all">
                        <i id="pause-icon" class="fa-solid fa-pause mr-1"></i> 暫停
                    </button>
                    <!-- 放棄挑戰 -->
                    <button onclick="quitChallenge()" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-rose-100 text-rose-700 hover:bg-rose-200 dark:bg-rose-950/40 dark:text-rose-300 dark:hover:bg-rose-900/50 transition-all">
                        <i class="fa-solid fa-circle-xmark mr-1"></i> 放棄
                    </button>
                </div>
            </div>

            <!-- 進度條 -->
            <div class="w-full bg-slate-200 dark:bg-slate-800 h-2 rounded-full overflow-hidden">
                <div id="reading-progress-bar" class="bg-gradient-to-r from-brand-500 to-indigo-600 h-2 rounded-full w-0 transition-all duration-300"></div>
            </div>

            <!-- 速讀文字的核心顯示跑道 -->
            <div id="reading-track" class="relative bg-white dark:bg-slate-900 rounded-3xl p-8 min-h-[350px] md:min-h-[420px] shadow-inner border border-slate-200 dark:border-slate-800 flex flex-col justify-end overflow-hidden">
                
                <!-- 遮罩陰影：加強沈浸感 -->
                <div class="absolute top-0 left-0 right-0 h-16 bg-gradient-to-b from-white dark:from-slate-900 to-transparent pointer-events-none z-10"></div>
                
                <!-- 文字承載容器 -->
                <div id="text-container" class="space-y-4 md:space-y-6 flex flex-col justify-end flex-grow transition-all duration-300">
                    <!-- 動態生成的每一行字將會放入此處 -->
                </div>
                
                <!-- 暫停覆蓋層 -->
                <div id="pause-overlay" class="hidden absolute inset-0 bg-slate-900/95 backdrop-blur-sm z-20 flex flex-col items-center justify-center space-y-4">
                    <div class="bg-amber-500 text-white p-4 rounded-full shadow-lg shadow-amber-500/20">
                        <i class="fa-solid fa-circle-pause text-4xl"></i>
                    </div>
                    <h3 class="text-xl font-bold text-slate-100">訓練暫停中</h3>
                    <p class="text-sm text-slate-400">深呼吸一口氣，準備好時點擊繼續</p>
                    <button onclick="togglePause()" class="px-6 py-2.5 bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-xl transition-all shadow-md">
                        繼續挑戰
                    </button>
                </div>
            </div>

            <p class="text-center text-xs text-slate-400 dark:text-slate-500">
                ⚠️ 警示：緊緊盯住下方新冒出的文字！倒數能量條見底時它就會消失。
            </p>
        </div>

        <!-- 5題選擇題測驗面板 (Quiz View) -->
        <div id="quiz-view" class="hidden space-y-6">
            <div class="bg-gradient-to-r from-brand-500 to-indigo-600 text-white p-6 rounded-2xl shadow-xl space-y-2">
                <div class="flex items-center justify-between">
                    <span class="px-3 py-1 bg-white/20 text-xs font-bold rounded-full">閱讀終了</span>
                    <span id="quiz-stepper" class="text-sm font-bold">第 1 / 5 題</span>
                </div>
                <h3 class="text-2xl font-black">理解度驗證</h3>
                <p class="text-slate-200 text-xs md:text-sm">速讀不僅要追求快速，更要確認有沒有讀懂！請回答以下問題。</p>
            </div>

            <!-- 單題測驗卡片 -->
            <div class="bg-white dark:bg-slate-900 p-6 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 space-y-6">
                <!-- 問題標題 -->
                <div class="space-y-2">
                    <p class="text-xs text-brand-500 font-bold uppercase tracking-wider">Question</p>
                    <h4 id="quiz-question-text" class="text-lg md:text-xl font-bold leading-relaxed">
                        這裡會顯示題目文字？
                    </h4>
                </div>

                <!-- 選項 -->
                <div id="quiz-options-container" class="grid grid-cols-1 gap-3">
                    <!-- 選項按鈕由 JS 動態生成 -->
                </div>
            </div>

            <!-- 測驗進度指示器 -->
            <div class="flex justify-between items-center text-sm text-slate-500">
                <span>請點選最合適的選項，答題後會自動進入下一題。</span>
            </div>
        </div>

        <!-- 挑戰結果畫面 (Results View) -->
        <div id="results-view" class="hidden space-y-6">
            <div class="text-center space-y-2">
                <h2 class="text-3xl font-extrabold tracking-tight">挑戰成果發表 🏆</h2>
                <p class="text-slate-500 dark:text-slate-400 text-sm">恭喜你完成速讀與理解度大作戰！這是你的綜合指標。</p>
            </div>

            <!-- 數據看板 grid -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <!-- 理解度 Score -->
                <div class="bg-white dark:bg-slate-900 p-6 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 flex flex-col items-center justify-center text-center space-y-2">
                    <span class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase">閱讀理解度</span>
                    <div class="relative w-28 h-28 flex items-center justify-center">
                        <svg class="absolute inset-0 w-full h-full transform -rotate-90" viewBox="0 0 36 36">
                            <path class="text-slate-200 dark:text-slate-800" stroke-width="3" stroke="currentColor" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                            <path id="result-score-ring" class="text-brand-500 transition-all duration-1000" stroke-dasharray="0, 100" stroke-width="3.2" stroke-linecap="round" stroke="currentColor" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                        </svg>
                        <span id="result-score-text" class="text-3xl font-black">0%</span>
                    </div>
                    <span id="result-evaluation" class="text-sm font-semibold text-brand-500">評價分析中...</span>
                </div>

                <!-- 閱讀字速 CPM -->
                <div class="bg-white dark:bg-slate-900 p-6 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 flex flex-col items-center justify-center text-center space-y-2">
                    <span class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase">每分鐘字速 (CPM)</span>
                    <div class="text-4xl md:text-5xl font-black text-indigo-500 my-4" id="result-cpm-text">
                        0 <span class="text-sm font-medium text-slate-400">字/分</span>
                    </div>
                    <p class="text-xs text-slate-500 leading-normal" id="result-cpm-desc">
                        一般人閱讀速度約為 300~500 字/分鐘。
                    </p>
                </div>

                <!-- 總體花費時間與設定 -->
                <div class="bg-white dark:bg-slate-900 p-6 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 flex flex-col justify-center space-y-3">
                    <div class="border-b border-slate-100 dark:border-slate-800 pb-2 flex justify-between items-center">
                        <span class="text-xs text-slate-400">挑戰文章</span>
                        <span class="text-sm font-bold text-slate-800 dark:text-slate-200 truncate max-w-[150px]" id="result-article-name">文章名</span>
                    </div>
                    <div class="border-b border-slate-100 dark:border-slate-800 pb-2 flex justify-between items-center">
                        <span class="text-xs text-slate-400">文章總字數</span>
                        <span class="text-sm font-bold text-slate-800 dark:text-slate-200" id="result-total-chars">0 字</span>
                    </div>
                    <div class="border-b border-slate-100 dark:border-slate-800 pb-2 flex justify-between items-center">
                        <span class="text-xs text-slate-400">消失倒數設定</span>
                        <span class="text-sm font-bold text-slate-800 dark:text-slate-200" id="result-seconds-setting">5s</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-xs text-slate-400">閱讀總耗時</span>
                        <span class="text-sm font-bold text-slate-800 dark:text-slate-200" id="result-time-taken">0s</span>
                    </div>
                </div>
            </div>

            <!-- 錯題解析與覆盤 -->
            <div class="bg-white dark:bg-slate-900 p-6 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 space-y-4">
                <h3 class="font-bold text-lg flex items-center space-x-2">
                    <i class="fa-solid fa-rectangle-list text-brand-500"></i>
                    <span>理解度題目覆盤解析</span>
                </h3>
                <div id="results-review-container" class="space-y-4 divide-y divide-slate-100 dark:divide-slate-800">
                    <!-- 解析由 JS 生成 -->
                </div>
            </div>

            <!-- 控制動作 -->
            <div class="flex flex-col md:flex-row gap-3 justify-center">
                <button onclick="restartSameChallenge()" class="px-6 py-3 bg-brand-500 hover:bg-brand-600 text-white font-bold rounded-xl transition-all shadow-md flex items-center justify-center space-x-2">
                    <i class="fa-solid fa-rotate"></i>
                    <span>再讀一次本篇</span>
                </button>
                <button onclick="goBackToLobby()" class="px-6 py-3 bg-slate-200 dark:bg-slate-800 text-slate-800 dark:text-slate-200 hover:bg-slate-300 dark:hover:bg-slate-700 font-bold rounded-xl transition-all flex items-center justify-center space-x-2">
                    <i class="fa-solid fa-house"></i>
                    <span>回到挑戰大廳</span>
                </button>
            </div>
        </div>

    </main>

    <!-- 歷史紀錄模態框 -->
    <div id="history-modal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-slate-950/60 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white dark:bg-slate-900 w-full max-w-lg rounded-2xl shadow-2xl border border-slate-200 dark:border-slate-800 overflow-hidden">
            <div class="bg-gradient-to-r from-brand-500 to-indigo-600 px-6 py-4 text-white flex justify-between items-center">
                <h3 class="font-bold text-lg flex items-center space-x-2">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                    <span>速讀挑戰歷史紀錄</span>
                </h3>
                <button onclick="toggleHistoryModal()" class="text-white/80 hover:text-white">
                    <i class="fa-solid fa-xmark text-xl"></i>
                </button>
            </div>
            
            <div class="p-6 space-y-4 max-h-[400px] overflow-y-auto" id="history-list-container">
                <!-- 歷史清單由 JS 渲染 -->
            </div>

            <div class="px-6 py-4 bg-slate-50 dark:bg-slate-950/50 border-t border-slate-200 dark:border-slate-800 flex justify-between items-center">
                <button onclick="clearAllHistory()" class="text-xs text-rose-500 hover:text-rose-600 font-bold">
                    <i class="fa-solid fa-trash mr-1"></i>清除所有紀錄
                </button>
                <button onclick="toggleHistoryModal()" class="px-4 py-2 bg-slate-200 dark:bg-slate-800 text-slate-800 dark:text-slate-200 text-sm font-bold rounded-lg hover:bg-slate-300 dark:hover:bg-slate-700">
                    關閉
                </button>
            </div>
        </div>
    </div>

    <!-- 頁尾 -->
    <footer class="border-t border-slate-200 dark:border-slate-800 py-6 text-center text-xs text-slate-400 dark:text-slate-500">
        <div class="max-w-6xl mx-auto px-4 space-y-1">
            <p>© 2026 閃電速讀訓練艙. 專為高效閱讀與大腦開發打造。</p>
            <p>💡 速讀心法：不要在心中默讀字音，改用眼睛當作鏡頭直接攝取單字與句子的塊狀意象！</p>
        </div>
    </footer>

    <script>
        /* ----------------------------------------------------
           1. 全域資料與文章庫定義
           ---------------------------------------------------- */
        const ARTICLES = [
            {
                id: "ai-future",
                title: "科技深淵：人工智慧與意識的邊界",
                difficulty: "中等",
                category: "科技大未來",
                icon: "fa-robot",
                color: "from-blue-500 to-cyan-500",
                lines: [
